  "narrative": {
    "northStar": "The Quiet Map",
    "overview": "Journey Viewer reads like a well-made map: a neutral ground, thin lines and small, exact marks. Structure carries the meaning. Colour appears only where it says something: a touchpoint\u2019s identity, a way in, a way out, the current focus. Everything else stays ink on paper. Depth is flat: white surfaces on a cool grey ground, separated by 1px hairlines; floating layers are the only things that cast a shadow.",
    "keyCharacteristics": [
      "Neutral ground with white surfaces and hairline borders.",
      "One accent, Focus Blue, reserved for selection and primary action.",
      "Relation colours with fixed meaning: Way In Teal and Way Out Violet.",
      "Touchpoint identity as small dots and 3px stripes, never as large fills.",
      "Inter at 13px for everything a reader scans.",
      "Scoped light and dark themes from the same DTCG tokens."
    ],
    "rules": [
      {
        "name": "The Meaningful Hue Rule",
        "body": "A hue appears only when it means something: focus, way in, way out, or a touchpoint. A decorative colour is a lie on a map.",
        "section": "colors"
      },
      {
        "name": "The Readable Line Rule",
        "body": "Lines that carry meaning (flow connectors and arrowheads) reach at least 3:1 against their ground in both themes. Hairlines are reserved for borders that only group content.",
        "section": "colors"
      },
      {
        "name": "The Thirteen Rule",
        "body": "Anything a reader scans is set at 13px. Smaller text is reserved for captions that qualify something already readable.",
        "section": "typography"
      },
      {
        "name": "The Paper Map Rule",
        "body": "Flow nodes and frames never cast shadows. The chart is printed on the ground, and only overlays float above it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every colour from the --jv-* custom properties so both themes follow automatically.",
      "Do keep Focus Blue for selection and the one primary action per view.",
      "Do mark relations with stripes plus soft fills (3px stripe, *-soft background), as the state row does.",
      "Do set scanned text at 13px Inter and qualifiers at 12px.",
      "Do give meaningful lines and glyphs at least 3:1 contrast against their ground in light and dark."
    ],
    "donts": [
      "Don\u2019t draw two lines between the same pair of blocks. Bundle them and count them instead.",
      "Don\u2019t put entries or exits in boxes or pills. They are glyphs on a border.",
      "Don\u2019t add shadows to flow nodes, frames or cards at rest.",
      "Don\u2019t use a touchpoint colour as a large fill. Dots, stripes and faint tints only.",
      "Don\u2019t hard-code hex values in component styles.",
      "Don\u2019t suggest depth with offset outlines (stacked-card edges); state lives in the toggle."
    ]
  }
}
