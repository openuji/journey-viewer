{
  "name": "journey-viewer-flow-spike",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:libraries": "pnpm --dir .. --filter @journey-viewer/viewer... build",
    "dev": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --host 127.0.0.1 -p 6016 --no-open",
    "build": "tsc -p tsconfig.json && STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "test": "node --import tsx --test tests/*.test.ts",
    "measure": "tsx scripts/measure.ts",
    "capture": "tsx scripts/capture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@journey-viewer/design-system": "link:../packages/design-system",
    "@journey-viewer/ujg-jsonld": "link:../packages/ujg-jsonld",
    "@journey-viewer/viewer": "link:../packages/viewer",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "elkjs": "0.12.0",
    "playwright": "1.61.1",
    "prettier": "3.9.10",
    "storybook": "10.4.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
