{
  "name": "@journey-viewer/app",
  "version": "0.1.0",
  "description": "Application shell and static-site CLI for viewing User Journey Graph documents.",
  "license": "MIT",
  "author": "Open User Journey Initiative",
  "homepage": "https://journey-viewer.openuji.org/",
  "bugs": {
    "url": "https://github.com/openuji/journey-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openuji/journey-viewer.git",
    "directory": "packages/app"
  },
  "keywords": [
    "user-journey",
    "user-journey-graph",
    "json-ld",
    "viewer",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "journey-viewer": "./dist/cli/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.site.config.ts && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && tsc -p tsconfig.cli.json && tsc-alias -p tsconfig.cli.json --resolve-full-paths",
    "test": "pnpm build && tsc -p tsconfig.json && tsx --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "storybook": "pnpm --filter @journey-viewer/app... build && STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --no-open",
    "build:storybook": "pnpm --filter @journey-viewer/app... build && STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "test:storybook": "node tests/storybook.mjs"
  },
  "dependencies": {
    "@journey-viewer/design-system": "workspace:^0.1.0",
    "@journey-viewer/lint": "workspace:^0.1.0",
    "@journey-viewer/ujg-jsonld": "workspace:^0.1.0",
    "@journey-viewer/viewer": "workspace:^0.1.0",
    "fflate": "0.8.3",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "@types/react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "playwright": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "storybook": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-a11y": "catalog:"
  }
}
