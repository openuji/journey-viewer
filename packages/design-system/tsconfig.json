{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true, "noEmit": true,
    "resolveJsonModule": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts/*.ts", ".storybook", "tests/*.ts", "vite.config.ts"]
}
