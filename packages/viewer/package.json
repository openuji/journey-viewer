{
  "name": "@journey-viewer/viewer",
  "version": "0.1.0",
  "description": "Interactive React tree and flow views for User Journey Graph documents.",
  "license": "MIT",
  "author": "Open User Journey Initiative",
  "homepage": "https://journey-viewer.openuji.org/",
  "bugs": {
    "url": "https://github.com/openuji/journey-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openuji/journey-viewer.git",
    "directory": "packages/viewer"
  },
  "keywords": [
    "user-journey",
    "user-journey-graph",
    "json-ld",
    "react",
    "viewer"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "test": "pnpm build && tsc -p tsconfig.json && tsx --test tests/*.test.mjs",
    "build:consumer": "tsc -p tests/consumer/tsconfig.json && vite build --config tests/consumer/vite.config.ts",
    "storybook": "pnpm --filter @journey-viewer/viewer... build && pnpm build:consumer && STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6007 --no-open",
    "build:storybook": "pnpm --filter @journey-viewer/viewer... build && pnpm build:consumer && STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "test:browser": "node tests/browser.mjs",
    "test:parity": "node tests/parity.mjs"
  },
  "dependencies": {
    "@journey-viewer/ujg-jsonld": "workspace:^0.1.0",
    "@journey-viewer/design-system": "workspace:^0.1.0",
    "@journey-viewer/flow-layout": "workspace:^0.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "@types/react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "storybook": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "playwright": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:"
  }
}
