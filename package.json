{
  "name": "journey-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm -r --if-present build",
    "build:app": "pnpm --dir apps/web build",
    "storybook:web": "pnpm --dir apps/web storybook",
    "build:storybook:web": "pnpm --dir apps/web build:storybook",
    "test": "pnpm -r --if-present test && node --test tests/*.test.mjs",
    "build:design-system": "pnpm --filter @journey-viewer/design-system build",
    "build:viewer": "pnpm --filter @journey-viewer/viewer... build",
    "storybook:viewer": "pnpm --filter @journey-viewer/viewer storybook",
    "build:storybook:viewer": "pnpm --filter @journey-viewer/viewer build:storybook",
    "test:viewer:browser": "pnpm build:storybook:viewer && pnpm --filter @journey-viewer/viewer test:browser",
    "check:tokens": "pnpm --filter @journey-viewer/design-system check:tokens",
    "generate:tokens": "pnpm --filter @journey-viewer/design-system generate:tokens",
    "check:fixtures": "pnpm --filter @journey-viewer/design-system check:fixtures",
    "storybook": "pnpm --filter @journey-viewer/design-system storybook",
    "build:storybook": "pnpm --filter @journey-viewer/design-system build:storybook",
    "test:design-system:browser": "pnpm --filter @journey-viewer/design-system test:browser",
    "test:parity": "pnpm --filter @journey-viewer/viewer test:parity"
  }
}
